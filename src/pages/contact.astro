---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SectionLabel from '../components/SectionLabel.astro';
import MobileMenu from '../components/MobileMenu.tsx';
import DonateDialog from '../components/DonateDialog.tsx';
---

<Layout title="Contact — Home for ₹1000" description="Contact the Home for ₹1000 team in Kerala. Contribute, volunteer, or nominate a family in need of a safe home." canonicalPath="/contact">
  <section class="relative m-3 min-h-[400px] overflow-hidden rounded-md sm:m-5 lg:min-h-[500px]">
    <img src="/images/home-inside-FFuOsBA9.jpg" alt="Contact us" class="absolute inset-0 size-full object-cover" />
    <div class="absolute inset-0 bg-foreground/40"></div>
    <Navbar />
    <div class="absolute bottom-8 left-5 z-10 max-w-xl sm:bottom-12 sm:left-10">
      <h1 class="text-4xl font-semibold text-background leading-[0.98] sm:text-6xl">Contact</h1>
      <p class="mt-4 max-w-md text-sm text-background/80 sm:text-base">Get in touch with us.</p>
    </div>
  </section>

  <section class="px-6 py-20 sm:px-12 lg:px-20 lg:py-28">
    <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <div>
        <SectionLabel text="Get in touch" />
        <h2 class="mt-4 text-4xl font-medium leading-none sm:text-5xl">We'd Love to<br />Hear From You.</h2>
        <p class="mt-5 max-w-md text-muted-foreground">Whether you want to contribute, volunteer, or nominate a family — reach out.</p>
        <div class="mt-10 space-y-4">
          <a href="https://wa.me/919000000000" target="_blank" rel="noreferrer" class="flex items-center gap-4 rounded-md border border-border bg-card p-4 transition-colors hover:border-primary hover:bg-primary/5">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary/15"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" /></svg></div>
            <div><p class="text-sm font-semibold">WhatsApp</p><p class="text-sm text-muted-foreground">+91 90000 00000</p></div>
          </a>
          <a href="tel:+919000000000" class="flex items-center gap-4 rounded-md border border-border bg-card p-4 transition-colors hover:border-primary hover:bg-primary/5">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary/15"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92Z" /></svg></div>
            <div><p class="text-sm font-semibold">Phone</p><p class="text-sm text-muted-foreground">+91 90000 00000</p></div>
          </a>
          <a href="mailto:hello@homefor1000.org" class="flex items-center gap-4 rounded-md border border-border bg-card p-4 transition-colors hover:border-primary hover:bg-primary/5">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary/15"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary"><rect width="20" height="16" x="2" y="4" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" /></svg></div>
            <div><p class="text-sm font-semibold">Email</p><p class="text-sm text-muted-foreground">hello@homefor1000.org</p></div>
          </a>
          <div class="flex items-center gap-4 rounded-md border border-border bg-card p-4">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary/15"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" /><circle cx="12" cy="10" r="3" /></svg></div>
            <div><p class="text-sm font-semibold">Location</p><p class="text-sm text-muted-foreground">Veliyathunad, Kerala, India</p></div>
          </div>
        </div>
      </div>

      <div>
        <SectionLabel text="Send a message" />
        <h3 class="mt-4 text-2xl font-medium">Contact Form</h3>
        <p class="mt-2 text-sm text-muted-foreground mb-8">Fill out the form and we'll get back to you.</p>
        <form class="space-y-5" onsubmit="event.preventDefault(); alert('Thank you! We will get back to you soon.')">
          <div class="grid gap-5 sm:grid-cols-2">
            <div><label for="name" class="block text-sm font-medium mb-1.5">Name</label><input type="text" id="name" required placeholder="Your name" class="w-full rounded-md border border-input bg-background px-4 py-2.5 text-sm outline-none focus:ring-2 focus:ring-primary transition-shadow" /></div>
            <div><label for="email" class="block text-sm font-medium mb-1.5">Email</label><input type="email" id="email" required placeholder="your@email.com" class="w-full rounded-md border border-input bg-background px-4 py-2.5 text-sm outline-none focus:ring-2 focus:ring-primary transition-shadow" /></div>
          </div>
          <div><label for="phone" class="block text-sm font-medium mb-1.5">Phone (optional)</label><input type="tel" id="phone" placeholder="+91 90000 00000" class="w-full rounded-md border border-input bg-background px-4 py-2.5 text-sm outline-none focus:ring-2 focus:ring-primary transition-shadow" /></div>
          <div><label for="subject" class="block text-sm font-medium mb-1.5">Subject</label><select id="subject" class="w-full rounded-md border border-input bg-background px-4 py-2.5 text-sm outline-none focus:ring-2 focus:ring-primary transition-shadow"><option value="">Select a topic</option><option value="donate">I want to donate</option><option value="volunteer">I want to volunteer</option><option value="nominate">Nominate a family</option><option value="other">Other</option></select></div>
          <div><label for="message" class="block text-sm font-medium mb-1.5">Message</label><textarea id="message" rows="5" required placeholder="Your message..." class="w-full rounded-md border border-input bg-background px-4 py-2.5 text-sm outline-none focus:ring-2 focus:ring-primary transition-shadow resize-none"></textarea></div>
          <button type="submit" class="btn-primary text-sm px-6 py-2.5 cursor-pointer">Send message</button>
        </form>
      </div>
    </div>
  </section>

  <section class="px-6 pb-20 sm:px-12 lg:px-20 lg:pb-28">
    <div class="rounded-md overflow-hidden border border-border">
      <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3928.5!2d76.3!3d10.0!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMTDCsDAwJzAwLjAiTiA3NsKwMTgnMDAuMCJF!5e0!3m2!1sen!2sin!4v1" width="100%" height="400" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Location map"></iframe>
    </div>
  </section>

  <Footer />
  <MobileMenu client:load />
  <DonateDialog client:load />
</Layout>
