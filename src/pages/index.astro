---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Accordion from '../components/Accordion.tsx';
import AmountSelector from '../components/AmountSelector.tsx';
import MobileMenu from '../components/MobileMenu.tsx';
import DonateDialog from '../components/DonateDialog.tsx';

const faqItems = [
  {
    question: 'How does my ₹1000 actually build a home?',
    answer: 'A safe, simple home costs far more than ₹1000 — but hundreds of people giving ₹1000 each adds up fast. Your contribution is pooled with others and goes directly into materials and labour for the current home.',
  },
  {
    question: 'Can I give something other than money?',
    answer: 'Yes! You can donate building materials like bricks, cement, sand, doors, and windows. You can also volunteer your time and skills on build days.',
  },
  {
    question: 'How are families chosen?',
    answer: 'Families are selected based on need, through community nominations and a transparent verification process. We prioritize those living in unsafe or inadequate housing.',
  },
  {
    question: 'How do I donate?',
    answer: 'You can contribute via bank transfer, UPI, or QR code. Click any "Donate" button on the site for payment details. Every contribution is tracked and receipts are provided.',
  },
  {
    question: 'Will I know which home my money helped build?',
    answer: 'Absolutely. We share regular updates on the current build — photos, progress reports, and family stories. When a home is completed, all contributors are acknowledged.',
  },
];

const helpCards = [
  { title: 'Contribute Money', description: '₹1000 or any amount, by QR code or bank transfer — pooled into the current build.', alt: 'Contribute Money' },
  { title: 'Donate Material', description: 'Bricks, cement, sand, doors, windows — materials go straight into the walls.', alt: 'Donate Material' },
  { title: 'Lend a Hand', description: 'Join a build day and help raise walls alongside the family and our volunteers.', alt: 'Lend a Hand' },
];

const projects = [
  { title: 'Home #6 — Under Construction', description: 'Walls are up and the roof is next. Help us finish the sixth home for a family of four.', raised: '₹1,88,000', goal: '₹4,50,000', progress: 42 },
  { title: 'Material Drive', description: 'Donate bricks, cement, sand, doors, or windows — material help builds homes as surely as money.', raised: '₹96,000', goal: '₹1,50,000', progress: 64 },
  { title: 'Family Support Fund', description: 'Furniture, a gas stove, and essentials so a new house becomes a liveable home from day one.', raised: '₹42,500', goal: '₹80,000', progress: 53 },
];
---

<Layout>
  <!-- Hero -->
  <section class="relative m-3 h-[60vh] min-h-80 overflow-hidden rounded-md sm:m-5 lg:h-[65vh]">
    <img src="/images/home-hero-OMYXYKhC.jpg" alt="A family standing proudly in front of their newly built home" width="1536" height="1024" fetchpriority="high" class="absolute inset-0 size-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-r from-foreground/15 via-transparent to-transparent"></div>
    <Navbar />
    <div class="absolute bottom-8 left-5 z-10 max-w-xl rounded-md bg-background/78 p-6 backdrop-blur-md sm:bottom-12 sm:left-10 sm:p-9">
      <h1 class="max-w-md text-4xl font-semibold leading-[0.98] sm:text-6xl">
        A Home of Their Own,<br />₹1000 at a Time.
      </h1>
      <p class="mt-5 max-w-md text-sm leading-relaxed text-muted-foreground sm:text-base">
        When a family gets a safe roof over their heads, everything changes — health, dignity, and a future to build on.
      </p>
      <div class="mt-6">
        <button data-donate-trigger class="btn-primary text-sm px-6 py-2.5 cursor-pointer">
          Give ₹1000
        </button>
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="px-6 py-20 sm:px-12 lg:px-20 lg:py-28">
    <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <div>
        <SectionLabel text="About us" />
        <h2 class="mt-4 max-w-sm text-4xl font-medium leading-none sm:text-5xl">Together, We Build More Than Houses.</h2>
      </div>
      <div>
        <p class="max-w-2xl text-xl leading-snug sm:text-2xl">
          Every family deserves a safe place to call home. Our community pools small contributions — money, material, and helping hands — to build simple, dignified homes for those who need them most.
        </p>
        <a href="/about" class="btn-outline h-9 px-4 py-2 mt-8 inline-flex items-center text-sm cursor-pointer">
          Our mission
        </a>
        <div class="mt-14 grid grid-cols-3 gap-3">
          <div class="bg-card p-4 sm:p-6">
            <strong class="block text-2xl sm:text-4xl">5</strong>
            <span class="mt-2 block text-xs text-muted-foreground sm:text-sm">Homes delivered</span>
          </div>
          <div class="bg-card p-4 sm:p-6">
            <strong class="block text-2xl sm:text-4xl">1</strong>
            <span class="mt-2 block text-xs text-muted-foreground sm:text-sm">Under construction</span>
          </div>
          <div class="bg-card p-4 sm:p-6">
            <strong class="block text-2xl sm:text-4xl">500+</strong>
            <span class="mt-2 block text-xs text-muted-foreground sm:text-sm">Contributors</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stories -->
  <section id="stories" class="px-6 pb-20 sm:px-12 lg:px-20 lg:pb-28">
    <div class="mb-10 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <SectionLabel text="How people help" />
        <h2 class="mt-3 text-4xl font-medium leading-none">Small Acts.<br />Standing Homes.</h2>
      </div>
      <p class="max-w-sm text-sm text-muted-foreground">Money, material, or muscle — every kind of help lays another brick.</p>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {helpCards.map((card) => (
        <article class="group relative overflow-hidden rounded-md border border-border bg-card card-hover">
          <div class="relative aspect-[4/3] overflow-hidden">
            <img src="/images/home-construction-B_u4OeLH.jpg" alt={card.alt} loading="lazy" width="1536" height="1024" class="size-full object-cover transition-transform duration-700 group-hover:scale-105" />
            <div class="absolute inset-0 bg-gradient-to-t from-foreground/80 via-transparent to-transparent"></div>
          </div>
          <div class="p-5">
            <h3 class="text-lg font-semibold">{card.title}</h3>
            <p class="mt-2 text-sm text-muted-foreground">{card.description}</p>
            <a href="/contact" class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-primary">
              Get involved
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Current Needs (YELLOW background) -->
  <section id="programs" class="bg-primary px-6 py-20 sm:px-12 lg:px-20 lg:py-24">
    <div class="mb-10 flex flex-col justify-between gap-5 lg:flex-row lg:items-end">
      <div>
        <p class="flex items-center gap-2 text-xs font-bold uppercase text-foreground">
          <span class="size-1.5 rounded-full bg-foreground"></span>
          Current needs
        </p>
        <h2 class="mt-3 text-4xl font-medium leading-none text-foreground sm:text-5xl">
          Make a Meaningful<br />Contribution Today
        </h2>
      </div>
      <p class="max-w-sm text-sm text-foreground/70">Transparent funding. Real walls and roofs. Every rupee moves a family forward.</p>
    </div>

    <div class="grid gap-4 md:grid-cols-3">
      {projects.map((project) => (
        <article class="rounded-md bg-background/25 p-6">
          <h3 class="text-xl font-semibold text-foreground">{project.title}</h3>
          <p class="mt-3 min-h-12 text-sm text-foreground/70">{project.description}</p>
          <div class="mt-8 flex justify-between text-xs text-foreground/60">
            <span>Raised<br /><strong class="text-foreground">{project.raised}</strong></span>
            <span class="text-right">Goal<br /><strong class="text-foreground">{project.goal}</strong></span>
          </div>
          <div class="mt-3 h-1.5 overflow-hidden rounded-full bg-background/45">
            <div class="h-full bg-foreground progress-fill" style={`width: ${project.progress}%`}></div>
          </div>
          <a href="/projects" class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-medium cursor-pointer transition-colors border border-foreground/30 bg-transparent text-foreground shadow-none hover:bg-foreground hover:text-background h-8 rounded-md px-3 text-xs mt-7">
            View project
          </a>
        </article>
      ))}
    </div>
  </section>

  <!-- Impact -->
  <section class="px-6 py-20 sm:px-12 lg:px-20 lg:py-28">
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
      <img src="/images/home-inside-FFuOsBA9.jpg" alt="Children studying in their family's new home" loading="lazy" width="1536" height="1024" class="aspect-[4/3] w-full rounded-md object-cover" />
      <div class="lg:pl-12">
        <SectionLabel text="Our impact" />
        <h2 class="mt-4 text-4xl font-medium leading-none sm:text-5xl">Homes That Hold Families for Generations.</h2>
        <p class="mt-6 max-w-xl leading-relaxed text-muted-foreground">
          A home is more than walls and a roof — it's children studying under a real light, elders sleeping safe from the rain, and a family cooking together in their own kitchen. That's what 5 homes have already made possible.
        </p>
        <a href="/projects" class="btn-outline h-9 px-4 py-2 mt-8 inline-flex items-center text-sm cursor-pointer">
          See our projects
        </a>
      </div>
    </div>

    <!-- FAQ -->
    <div class="mt-16 grid gap-12 lg:grid-cols-2">
      <div>
        <SectionLabel text="FAQs" />
        <h2 class="mt-4 text-4xl font-medium leading-none sm:text-5xl">Frequently Asked<br />Questions?</h2>
        <p class="mt-5 max-w-md text-muted-foreground">Every rupee you contribute goes toward material, labour, and a finished home.</p>
      </div>
      <div>
        <Accordion items={faqItems} defaultOpen={0} client:load />
      </div>
    </div>
  </section>

  <!-- Donation CTA -->
  <section class="grid border-y border-border lg:grid-cols-[1.2fr_0.8fr]">
    <div class="px-6 py-16 sm:px-12 lg:px-20 lg:py-20">
      <AmountSelector client:load />
    </div>
    <img src="/images/home-handover-pJAxTwgq.jpg" alt="A family's joy at the handover of their new home" loading="lazy" width="1536" height="1024" class="h-full min-h-[420px] w-full object-cover" />
  </section>

  <Footer />
  <MobileMenu client:load />
  <DonateDialog client:load />
</Layout>
